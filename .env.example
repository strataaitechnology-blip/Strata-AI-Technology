# ─────────────────────────────────────────────────────────────
# STRATA Technologies — environment variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` or any real credentials.
# ─────────────────────────────────────────────────────────────

# Production URL of the website (no trailing slash).
# Used for canonical URLs, Open Graph, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Public contact details. Leave empty until real values exist —
# empty values are shown as placeholders and are NEVER added to structured data.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Social profile URLs. Leave empty until the real profiles exist.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=

# ── Contact form delivery (server-side only) ─────────────────
# none    → the form reports honestly that delivery is not configured (default)
# console → development only: logs the inquiry to the server console
# resend  → sends email through the Resend REST API (https://resend.com)
CONTACT_PROVIDER=none

# Required when CONTACT_PROVIDER=resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
